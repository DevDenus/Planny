# `make env` writes deploy/.env with random values for the dev machine.
# On the server, fill these in by hand and keep the file out of the repository.

# openssl rand -hex 32. Hex only: the value goes into a database URL unescaped.
POSTGRES_PASSWORD=

# openssl rand -hex 32
BFF_SHARED_SECRET=

# openssl rand -base64 32 | tr '+/' '-_'
COOKIE_KEY=

# false on the dev machine, true on the server (HTTPS, __Host- cookies)
COOKIE_SECURE=false

# true only behind Caddy, which writes the real client address to X-Forwarded-For
TRUST_FORWARDED_FOR=false

# Server only: the LAN address the API port is published on
LAN_IP=
