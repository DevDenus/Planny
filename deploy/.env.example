# `make env` writes deploy/.env with random values for the dev machine.
# On the server, deploy/server/update.sh generates the file on its first run: fill in LAN_IP and
# check BACKUP_*. Keep the file out of the repository.

# openssl rand -hex 32. Hex only: the value goes into a database URL unescaped.
POSTGRES_PASSWORD=

# openssl rand -hex 32
BFF_SHARED_SECRET=

# openssl rand -base64 32 | tr '+/' '-_'
COOKIE_KEY=

# false on the dev machine, true on the server (HTTPS, __Host- cookies)
COOKIE_SECURE=false

# true only behind Caddy, which writes the real client address to X-Forwarded-For
TRUST_FORWARDED_FOR=false

# Server only: the LAN address the API port is published on
LAN_IP=

# Server only: the release that runs. deploy/server/update.sh writes it; empty means `dev` locally
PLANNY_VERSION=

# Server only: where backups go, a directory on the second disk (/mnt/hdd2/planny-backups).
# Empty on the dev machine: backup.sh uses deploy/backup/dumps
BACKUP_DIR=

# Server only: the second disk's mount point (/mnt/hdd2). backup.sh refuses to write while it is
# not mounted, so a missing disk does not silently fill the system disk
BACKUP_MOUNT=

# Backups older than this many days are deleted after a new one succeeds
BACKUP_KEEP_DAYS=14
